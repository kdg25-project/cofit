{
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"types": ["@cloudflare/workers-types", "node"],
		"outDir": "dist"
	},
	"include": ["worker-configuration.d.ts", "src/**/*"]
}
